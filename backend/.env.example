# =============================================================================
# FLUXY BACKEND — CONFIGURAÇÃO DE AMBIENTE
# Preencha os campos em branco antes de subir para produção.
# =============================================================================


# ── Ambiente ──────────────────────────────────────────────────────────────────
NODE_ENV=production


# ── Banco de dados (MySQL) ────────────────────────────────────────────────────
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=


# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=8000
TRUST_PROXY=1
REQUEST_BODY_LIMIT_MB=2


# ── Domínio e URLs ────────────────────────────────────────────────────────────
APP_DOMAIN=
FRONTEND_URL=
FRONTEND_PUBLIC_URL=
APP_FRONTEND_URL=

# Origens permitidas para CORS (separadas por vírgula)
CORS_ALLOWED_ORIGINS=


# ── Identidade da aplicação ───────────────────────────────────────────────────
PRODUCT_NAME=
COMPANY_NAME=
COMPANY_LEGAL_NAME=
COMPANY_LOGO_URL=


# ── Autenticação JWT ──────────────────────────────────────────────────────────
# Gere com: openssl rand -hex 64
JWT_SECRET=
JWT_EXPIRES_IN=8h


# ── Cookies de autenticação ───────────────────────────────────────────────────
AUTH_COOKIE_NAME=fluxy_auth
AUTH_COOKIE_SAME_SITE=lax
# Em produção com HTTPS deve ser true
AUTH_COOKIE_SECURE=true
# Deixe em branco para usar o domínio padrão, ou informe ex: .seudominio.com.br
AUTH_COOKIE_DOMAIN=


# ── CSRF ──────────────────────────────────────────────────────────────────────
CSRF_COOKIE_NAME=fluxy_csrf
CSRF_HEADER_NAME=X-CSRF-Token


# ── MFA ───────────────────────────────────────────────────────────────────────
# Aparece no aplicativo autenticador (ex: Google Authenticator)
MFA_ISSUER=
MFA_CHALLENGE_EXPIRES_IN=5m


# ── Rate limiting ─────────────────────────────────────────────────────────────
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
UPLOAD_RATE_LIMIT_WINDOW_MINUTES=5
UPLOAD_RATE_LIMIT_MAX_ATTEMPTS=30
CRITICAL_RATE_LIMIT_WINDOW_MINUTES=1
CRITICAL_RATE_LIMIT_MAX_ATTEMPTS=60
PASSWORD_RATE_LIMIT_WINDOW_MINUTES=15
PASSWORD_RATE_LIMIT_MAX_ATTEMPTS=5


# ── Uploads e importações ─────────────────────────────────────────────────────
UPLOAD_MAX_FILE_SIZE_MB=10
CSV_IMPORT_MAX_ROWS=5000


# ── AWS S3 (armazenamento de arquivos) ────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=


# ── Redis / Valkey (cache e filas) ────────────────────────────────────────────
REDIS_URL=
REDIS_REQUIRED=false
REDIS_KEY_PREFIX=fluxy:


# ── ClamAV (antivírus — opcional) ────────────────────────────────────────────
CLAMAV_ENABLED=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
CLAMAV_FAIL_CLOSED=false
CLAMAV_REQUIRED=false


# ── Logs de segurança ─────────────────────────────────────────────────────────
SECURITY_LOG_RETENTION_DAYS=90


# ── Geração de PDF (Puppeteer/Chrome) ─────────────────────────────────────────
# Descomente e informe o caminho do Chrome instalado no servidor, se necessário
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
# CHROME_EXECUTABLE_PATH=/usr/bin/google-chrome-stable


# ── CRM — Automações ──────────────────────────────────────────────────────────
CRM_AUTOMATION_ENABLED=true
CRM_AUTOMATION_INTERVAL_SECONDS=60
CRM_AUTOMATION_STARTUP_DELAY_MS=15000
CRM_AUTOMATION_BATCH_SIZE=100

# Nota: as integrações com Meta (Facebook Lead Ads) e Google Ads são
# configuradas pelo painel da aplicação após o deploy (ficam no banco de dados).


# ── Painel Ops Fluxy (monitoramento — opcional) ───────────────────────────────
OPS_ENABLED=false
OPS_BASE_URL=
OPS_CLIENT_ID=
OPS_API_KEY=
OPS_HEARTBEAT_INTERVAL_MINUTES=5
OPS_METRICS_INTERVAL_MINUTES=15


# ── Integração SIENGE ─────────────────────────────────────────────────────────
# Use SIENGE_API_BASE_URL para informar a URL completa, ou use
# SIENGE_API_SUBDOMAIN para montar a URL automaticamente.
SIENGE_API_BASE_URL=
SIENGE_API_HOST=https://api.sienge.com.br
SIENGE_API_SUBDOMAIN=
SIENGE_API_BASE_PATH=/public/api/v1
SIENGE_USERNAME=
SIENGE_PASSWORD=
SIENGE_TOKEN=
SIENGE_REQUEST_TIMEOUT_MS=20000
SIENGE_ENDPOINT_TITULOS=bills
SIENGE_ENDPOINT_CREDORES=creditors
SIENGE_ENDPOINT_CREDOR_DETALHE=creditors/{creditorId}
SIENGE_ENDPOINT_CREDOR_BANK_INFORMATIONS=creditors/{creditorId}/bank-informations
SIENGE_ENDPOINT_CREDOR_PIX_INFORMATIONS=creditors/{creditorId}/pix-informations


# ── Boletos Caixa Econômica (SIGCB) ──────────────────────────────────────────
# Necessário homologar amostras com a Caixa antes de emitir em produção.
# Mude CAIXA_BOLETO_AMBIENTE para PRODUCAO somente após homologação aprovada.
CAIXA_BOLETO_AMBIENTE=TESTE
CAIXA_BOLETO_HOMOLOGADO=false
CAIXA_AGENCIA=
CAIXA_CODIGO_BENEFICIARIO=
CAIXA_BENEFICIARIO_NOME=
CAIXA_BENEFICIARIO_CPF_CNPJ=
CAIXA_BENEFICIARIO_ENDERECO=
CAIXA_LOCAL_PAGAMENTO=EM TODA A REDE BANCARIA E SEUS CORRESPONDENTES ATE O VALOR LIMITE
CAIXA_BOLETO_INSTRUCAO=


# ── D4Sign (assinatura digital — opcional) ────────────────────────────────────
D4SIGN_BASE_URL=https://secure.d4sign.com.br/api/v1
D4SIGN_TOKEN_API=
D4SIGN_CRYPT_KEY=
D4SIGN_SAFE_UUID=
# URL pública onde o D4Sign enviará notificações (ex: https://api.seudominio.com.br/webhooks/d4sign)
D4SIGN_WEBHOOK_URL=
D4SIGN_WEBHOOK_SECRET=
D4SIGN_SKIP_EMAIL=false
D4SIGN_WORKFLOW=
