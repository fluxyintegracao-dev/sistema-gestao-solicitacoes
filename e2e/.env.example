# ─────────────────────────────────────────────────────────────
# FLUXY — Variáveis de Ambiente para Testes E2E
# Copie este arquivo para .env e preencha com os dados reais
# ─────────────────────────────────────────────────────────────

# URL base do frontend (padrão: desenvolvimento local)
BASE_URL=http://localhost:5173

# URL da API backend
API_URL=http://localhost:3000

# Credenciais do usuário administrador para os testes
# O usuário deve ter perfil ADMIN ou SUPERADMIN
ADMIN_EMAIL=admin@fluxy.com.br
ADMIN_SENHA=admin123

# Credenciais de usuário comum (sem perfil admin) para testes de permissão
USER_EMAIL=usuario@fluxy.com.br
USER_SENHA=usuario123

# ─────────────────────────────────────────────────────────────
# Configurações opcionais para CI/CD
# ─────────────────────────────────────────────────────────────

# Define se está em ambiente CI (afeta retries e workers)
# CI=true

# Número máximo de retries em falha (padrão: 2 no CI, 0 em dev)
# PLAYWRIGHT_RETRIES=2
