{
  "name": "fluxy-e2e-tests",
  "version": "1.0.0",
  "description": "Testes E2E do sistema FLUXY - Gestão de Solicitações",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "test:auth": "playwright test tests/auth.spec.js",
    "test:dashboard": "playwright test tests/dashboard.spec.js",
    "test:solicitacoes": "playwright test tests/solicitacoes.spec.js",
    "test:compras": "playwright test tests/compras.spec.js",
    "test:financeiro": "playwright test tests/financeiro.spec.js",
    "test:admin": "playwright test tests/admin.spec.js",
    "test:smoke": "playwright test --grep @smoke"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "dotenv": "^16.4.5"
  }
}
